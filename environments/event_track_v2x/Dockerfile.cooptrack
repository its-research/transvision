FROM mambaorg/micromamba:2.8.1@sha256:79284aa2949ac9555eca7e975ceb4ecefefc5964a2d4fdd4e181ca8eaccf347e AS micromamba
FROM nvidia/cuda:11.8.0-cudnn8-devel-ubuntu22.04@sha256:14da408c90a184d9c08fe226fa86cea1588ce26aff9c8fdeac889e94dd129ddf

# Upstream CoopTrack INSTALL.md pins this legacy Python / OpenMMLab stack.
# This image contains no dataset, training labels, credentials or user checkout.
COPY --from=micromamba /bin/micromamba /bin/micromamba
RUN apt-get update && apt-get install --yes --no-install-recommends git ca-certificates libgl1 libglib2.0-0
RUN micromamba create --yes --prefix /opt/cooptrack --channel conda-forge python=3.8.20 pip=24.2
ENV PATH=/opt/cooptrack/bin:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    CUDA_HOME=/usr/local/cuda FORCE_CUDA=1 TORCH_CUDA_ARCH_LIST="8.0;8.6" \
    MAX_JOBS=4 PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1
RUN python -m pip install --no-cache-dir setuptools==59.5.0 wheel==0.38.4 numpy==1.19.5 \
    torch==1.9.1+cu111 torchvision==0.10.1+cu111 \
    --find-links https://download.pytorch.org/whl/torch_stable.html
RUN python -m pip install --no-cache-dir --only-binary mmcv-full mmcv-full==1.4.0 \
    --find-links https://download.openmmlab.com/mmcv/dist/cu111/torch1.9.0/index.html
RUN python -m pip install --no-cache-dir --index-url https://pypi.tuna.tsinghua.edu.cn/simple \
    mmdet==2.14.0 mmsegmentation==0.14.1 \
    motmetrics==1.1.3 einops==0.4.1 yapf==0.40.1 \
    numpy==1.19.5 scipy==1.7.3 matplotlib==3.5.3 pandas==1.4.4 scikit-learn==1.0.2 \
    cachetools==5.5.2 descartes==1.1.0 fire==0.5.0 pyquaternion==0.9.9 Shapely==1.8.5.post1 \
    tqdm==4.66.5 plotly==5.24.1 networkx==2.2 \
    numba==0.48.0 plyfile==0.7.4 scikit-image==0.19.3 tensorboard==2.11.2 \
    trimesh==2.35.39 protobuf==3.20.3
# Dataset SDK metadata includes notebook/lint/test suites, which are not part of
# this headless training runtime. Their actual runtime dependencies are above.
RUN python -m pip install --no-cache-dir --no-deps --index-url https://pypi.tuna.tsinghua.edu.cn/simple \
    nuscenes-devkit==1.1.9 lyft-dataset-sdk==0.0.8
RUN python -m pip install --no-cache-dir --index-url https://pypi.tuna.tsinghua.edu.cn/simple opencv-python==4.5.5.64 \
    pillow==9.5.0 prettytable==2.5.0 ipython==8.12.3 fvcore==0.1.5.post20221221
# Obtain this build input from the exact official commit:
# https://codeload.github.com/open-mmlab/mmdetection3d/tar.gz/f1107977dfd26155fc1f83779ee6535d2468f449
COPY mmdetection3d-f1107977.tar.gz /tmp/mmdetection3d.tar.gz
RUN echo "eed7992eb2e6a80599c8ca7bcfabb52160362346f6542ecc0e7bf51381a7696c  /tmp/mmdetection3d.tar.gz" | sha256sum -c - \
    && mkdir /opt/mmdetection3d \
    && tar -xzf /tmp/mmdetection3d.tar.gz --strip-components=1 -C /opt/mmdetection3d \
    && python -m pip install --no-cache-dir --no-deps --no-build-isolation /opt/mmdetection3d
RUN python -c "import torch, torchvision, mmcv, mmdet, mmseg, mmdet3d; import mmcv._ext; assert torch.__version__ == '1.9.1+cu111'; assert torchvision.__version__ == '0.10.1+cu111'; assert mmcv.__version__ == '1.4.0'; assert mmdet.__version__ == '2.14.0'; assert mmdet3d.__version__ == '0.17.1'"
WORKDIR /workspace/CoopTrack
CMD ["python", "--version"]
