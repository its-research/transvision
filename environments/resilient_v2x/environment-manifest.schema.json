{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resilient-v2x.invalid/environment-manifest.schema.json",
  "title": "ResilientV2X environment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "classification",
    "platform",
    "python",
    "packages",
    "cuda",
    "custom_ops",
    "determinism",
    "runtime_lock_sha256",
    "bootstrap_lock_sha256",
    "container_image_digest",
    "hardware",
    "actual_hardware_fingerprint_sha256",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "classification": {
      "enum": [
        "development",
        "controlled"
      ]
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "machine",
        "cpu_model",
        "logical_cpu_count",
        "total_ram_bytes"
      ],
      "properties": {
        "system": {
          "type": "string"
        },
        "machine": {
          "type": "string"
        },
        "cpu_model": {
          "type": "string"
        },
        "logical_cpu_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_ram_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "python": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "implementation"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "implementation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "packages": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "cuda": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "driver",
        "runtime",
        "cudnn_version"
      ],
      "properties": {
        "driver": {
          "type": "string"
        },
        "runtime": {
          "type": "string"
        },
        "cudnn_version": {
          "type": "string"
        }
      }
    },
    "custom_ops": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": [
          "imported",
          "not_available"
        ]
      }
    },
    "determinism": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cudnn_benchmark",
        "tf32"
      ],
      "properties": {
        "cudnn_benchmark": {
          "type": "boolean"
        },
        "tf32": {
          "type": "boolean"
        }
      }
    },
    "runtime_lock_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "bootstrap_lock_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "container_image_digest": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      ]
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform_system",
        "platform_machine",
        "cpu_model",
        "logical_cpu_count",
        "total_ram_bytes",
        "gpu_devices",
        "cuda_driver",
        "cuda_runtime",
        "cudnn_version",
        "world_size",
        "fingerprint_sha256"
      ],
      "properties": {
        "platform_system": {
          "type": "string"
        },
        "platform_machine": {
          "type": "string"
        },
        "cpu_model": {
          "type": "string"
        },
        "logical_cpu_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_ram_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "gpu_devices": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "uuid",
              "compute_capability",
              "memory_bytes"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "uuid": {
                "type": "string"
              },
              "compute_capability": {
                "type": "string"
              },
              "memory_bytes": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "cuda_driver": {
          "type": "string"
        },
        "cuda_runtime": {
          "type": "string"
        },
        "cudnn_version": {
          "type": "string"
        },
        "world_size": {
          "enum": [
            1,
            2,
            4
          ]
        },
        "fingerprint_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "actual_hardware_fingerprint_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "manifest_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
