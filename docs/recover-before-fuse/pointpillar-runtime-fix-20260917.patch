+def read_source_bundle(bundle):
+    bundle = Path(bundle)
+    if bundle.stat().st_size > 32 * 1024 * 1024:
+        raise ValueError("source bundle too large")
+    content = json.loads(bundle.read_text())
+    if set(content) != {"commit", "files"} or content["commit"] != COMMIT:
+        raise ValueError("source bundle commit mismatch")
+    files = content["files"]
+    if not isinstance(files, dict) or set(files) != set(SOURCE_PINS):
+        raise ValueError("source bundle inventory mismatch")
+    for name, digest in SOURCE_PINS.items():
+        if not isinstance(files[name], str):
+            raise ValueError("source bundle text required")
+        payload = files[name].encode("utf-8")
+        if len(payload) > 2 * 1024 * 1024 or hashlib.sha256(payload).hexdigest() != digest:
+            raise ValueError(f"source bundle SHA-256 mismatch: {name}")
+    return files
+
