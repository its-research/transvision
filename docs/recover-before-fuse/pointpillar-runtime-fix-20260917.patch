+def write_source_bundle(source, bundle):
+    verify_sources(source)
+    with Path(bundle).open("x") as stream:
+        json.dump(dict(commit=COMMIT, files={name: (Path(source) / name).read_bytes().decode("utf-8")
+                                            for name in SOURCE_PINS}), stream, sort_keys=True)
+    read_source_bundle(bundle)
+
